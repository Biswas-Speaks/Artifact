# ─────────────────────────────────────────────────────────────────
#  Biswa Artifacts — environment variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# Your root domain (no protocol, no trailing slash)
BASE_DOMAIN=biswa.io

# Full public-facing URL used in email links
SITE_URL=https://biswa.io

# Protocol for public URLs ("https" in production, "http" locally)
PUBLIC_PROTO=https

# Leave empty to use the default port for the protocol
PUBLIC_PORT=

# Random 32+ char secret — generate with: openssl rand -hex 32
JWT_SECRET=

# ── Neon PostgreSQL ───────────────────────────────────────────────
# Full connection string including ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ── Gmail SMTP (Google App Password) ─────────────────────────────
# The Gmail address used as the "From" sender
GMAIL_USER=yourname@gmail.com

# 16-character App Password (spaces are stripped automatically)
# Generate at: myaccount.google.com → Security → App passwords
GMAIL_APP_PASSWORD=

# ── Cloudflare R2 ────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional: permanent public URL for the R2 bucket
# Leave empty to use 7-day signed links
# Example: https://files.biswa.io
R2_PUBLIC_URL=

# ── Cloudinary ───────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
