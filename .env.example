# ─────────────────────────────────────────────────────────────────
#  Biswa Artifacts — environment variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# Your root domain (no protocol, no trailing slash)
BASE_DOMAIN=biswa.io

# Full public-facing URL used in email links
SITE_URL=https://biswa.io

# Protocol for public URLs ("https" in production, "http" locally)
PUBLIC_PROTO=https

# Leave empty to use the default port for the protocol
PUBLIC_PORT=

# Random 32+ char secret — generate with: openssl rand -hex 32
JWT_SECRET=

# ── Neon PostgreSQL ───────────────────────────────────────────────
# Full connection string including ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ── Gmail SMTP (Google App Password) ─────────────────────────────
# The Gmail address used as the "From" sender
GMAIL_USER=yourname@gmail.com

# 16-character App Password (spaces are stripped automatically)
# Generate at: myaccount.google.com → Security → App passwords
GMAIL_APP_PASSWORD=

# ── Cloudflare R2 ────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional: permanent public URL for the R2 bucket
# Leave empty to use 7-day signed links
# Example: https://files.biswa.io
R2_PUBLIC_URL=

# ── Cloudinary ───────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Admin ─────────────────────────────────────────────────────────
# Email address automatically promoted to admin on first login.
# The account does not need to exist yet — it will be promoted when
# a user with this email logs in.
ADMIN_EMAIL=you@example.com

# ── Cloudflare Turnstile (bot protection on the Report form) ──────
# Leave BOTH blank to fall back to IP-rate-limiting (fine for local dev).
# Get keys at: dash.cloudflare.com → Turnstile → Add widget
# Widget type: "Managed" is recommended.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ── First-publish approval mode ───────────────────────────────────
# "auto"   — all publishes go live immediately (default).
# "manual" — a user's FIRST publish is held for admin review.
#            After admin approval the user is trusted and future
#            publishes go live immediately.
APPROVAL_MODE=auto

# ── IP hashing salt (for report abuse detection) ─────────────────
# Used to HMAC-hash reporter IPs before storing. Never stores raw IPs.
# Falls back to JWT_SECRET if not set. Generate: openssl rand -hex 16
IP_SALT=

# ── Quotas (all optional — defaults shown) ───────────────────────
# Maximum number of published artifacts per user
MAX_PUBLISHED_PER_USER=3

# Maximum total artifacts (draft + published) per user
MAX_ARTIFACTS_PER_USER=20

# Maximum total size of one artifact in bytes (all pages + css + js)
MAX_ARTIFACT_BYTES=512000

# Maximum Cloudflare R2 file storage per user in megabytes
MAX_STORAGE_PER_USER_MB=100

# Maximum Cloudinary images per user
MAX_IMAGES_PER_USER=50

# Maximum single image upload size in bytes (default 10 MB)
MAX_IMAGE_BYTES=10485760

# ── Cookie security ───────────────────────────────────────────────
# Uncomment and set to "false" only when testing over plain HTTP.
# In production this defaults to true automatically when NODE_ENV=production.
# COOKIE_SECURE=false
